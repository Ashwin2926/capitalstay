## Standard React Client-Side Routing Configuration

# 1. Turn on the Rewrite Engine
RewriteEngine On

# 2. Set the base directory for rewriting rules
# If your application is in the root (public_html), use /
RewriteBase /

# 3. Exclude existing files and directories from the rewrite rule
# If the requested URI is a real file (e.g., /assets/logo.webp), skip rewriting
# If the requested URI is a real directory, skip rewriting

# 4. Rewrite all other requests to index.html
# For all other requests (like /about or /view-properties),
# internally rewrite the path to load index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

## END React Routing
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^www\.capitalstayuae\.com$
RewriteRule ^(.*)$ "https\:\/\/www\.capitalstayuae\.com\/$1" [R=301,L]

